---
import ToolLayout from '../components/ToolLayout.astro';
---

<ToolLayout
  title="Medidor de latencia"
  description="Medí cuánto tarda en responder cualquier sitio web, con mediciones reales desde Cloudflare."
  heading="Medidor de latencia"
  subheading="Medí cuánto tarda en responder un sitio. Hacemos 3 mediciones reales desde el datacenter de Cloudflare más cercano a vos."
>
  <div slot="form">
    <div class="form-row">
      <div class="input-group">
        <label for="url-input">URL o dominio</label>
        <input
          type="text"
          id="url-input"
          placeholder="ejemplo.com"
          autocomplete="off"
          spellcheck="false"
        />
      </div>
      <button class="btn" id="check-btn">Medir</button>
    </div>
    <div class="loading" id="loading"><div class="spinner"></div> Midiendo...</div>
    <div class="error-msg" id="error"></div>
  </div>

  <div slot="results" id="results-container" style="display:none;" aria-live="polite">
    <p class="honest-note" id="origin-note"></p>
    <div class="summary-cards">
      <div class="summary-card card fastest">
        <div class="summary-label">Mejor</div>
        <div class="summary-value" id="fastest-value">--</div>
        <div class="summary-location">de 3 mediciones</div>
      </div>
      <div class="summary-card card average">
        <div class="summary-label">Mediana</div>
        <div class="summary-value" id="average-value">--</div>
        <div class="summary-location">valor típico</div>
      </div>
      <div class="summary-card card slowest">
        <div class="summary-label">Peor</div>
        <div class="summary-value" id="slowest-value">--</div>
        <div class="summary-location">de 3 mediciones</div>
      </div>
    </div>

    <div class="latency-chart card">
      <div class="chart-header">
        <h3>Mediciones</h3>
        <div class="chart-legend">
          <span class="legend-item fast"><span class="dot"></span>Rápido (&lt;300ms)</span>
          <span class="legend-item medium"><span class="dot"></span>Medio (300 a 1000ms)</span>
          <span class="legend-item slow"><span class="dot"></span>Lento (&gt;1000ms)</span>
        </div>
      </div>
      <div class="chart-body" id="chart-body"></div>
    </div>

    <div class="insights card" id="insights">
      <h3>Qué significa</h3>
      <div class="insights-content" id="insights-content"></div>
    </div>
  </div>
</ToolLayout>

<style>
  .honest-note { font-size: 0.9rem; color: var(--gris-medio); margin-bottom: 1rem; }

  .form-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-end;
  }

  .input-group {
    flex: 1;
  }

  .summary-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .summary-card {
    padding: 1.25rem;
    text-align: center;
    border-left: 3px solid var(--borde);
  }

  .summary-card.fastest {
    border-left-color: #10B981;
  }

  .summary-card.average {
    border-left-color: #6B7280;
  }

  .summary-card.slowest {
    border-left-color: #EF4444;
  }

  .summary-label {
    font-size: 0.75rem;
    color: var(--gris-medio);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .summary-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--gris-oscuro);
    font-family: var(--font-mono);
  }

  .summary-location {
    font-size: 0.85rem;
    color: var(--gris-medio);
    margin-top: 0.25rem;
  }

  .latency-chart {
    padding: 1.25rem;
    margin-bottom: 1rem;
  }

  .chart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .chart-header h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }

  .chart-legend {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--gris-medio);
  }

  .legend-item .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .legend-item.fast .dot { background: #10B981; }
  .legend-item.medium .dot { background: #F59E0B; }
  .legend-item.slow .dot { background: #EF4444; }

  .chart-body {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .region-group {
    border-bottom: 2px solid var(--borde);
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .region-group:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .region-header {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--gris-medio);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.5rem 0 0.25rem 0;
    margin-bottom: 0.25rem;
  }

  .latency-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--borde);
  }

  .latency-row:last-child {
    border-bottom: none;
  }

  .region-info {
    width: 150px;
    flex-shrink: 0;
  }

  .region-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--gris-oscuro);
  }

  .region-code {
    font-size: 0.7rem;
    color: var(--gris-medio);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .bar-container {
    flex: 1;
    height: 28px;
    background: var(--fondo-alt);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  .bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.5s ease-out;
    position: relative;
  }

  .bar-fill.fast { background: linear-gradient(90deg, #10B981, #34D399); }
  .bar-fill.medium { background: linear-gradient(90deg, #F59E0B, #FBBF24); }
  .bar-fill.slow { background: linear-gradient(90deg, #EF4444, #F87171); }

  .bar-value {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: white;
    text-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }

  .insights {
    padding: 1.25rem;
  }

  .insights h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.75rem 0;
  }

  .insights-content {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--gris-oscuro);
  }

  .insight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .insight-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 0.75rem;
  }

  .insight-icon.good {
    background: #D1FAE5;
    color: #065F46;
  }

  .insight-icon.warning {
    background: #FEF3C7;
    color: #92400E;
  }

  .insight-icon.info {
    background: #DBEAFE;
    color: #1E40AF;
  }

  @media (max-width: 600px) {
    .form-row {
      flex-direction: column;
      align-items: stretch;
    }

    .form-row .btn {
      width: 100%;
      justify-content: center;
    }

    .summary-cards {
      grid-template-columns: 1fr;
    }

    .chart-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .region-info {
      width: 110px;
    }

    .region-name {
      font-size: 0.8rem;
    }
  }
</style>

<script>
  const urlInput = document.getElementById('url-input') as HTMLInputElement;
  const btn = document.getElementById('check-btn')!;
  const loading = document.getElementById('loading')!;
  const error = document.getElementById('error')!;
  const container = document.getElementById('results-container')!;

  const speed = (ms: number) => (ms < 300 ? 'fast' : ms < 1000 ? 'medium' : 'slow');

  async function check() {
    const url = urlInput.value.trim();
    error.classList.remove('active');
    container.style.display = 'none';
    if (!url) {
      error.textContent = 'Ingresá una URL o dominio.';
      error.classList.add('active');
      return;
    }
    loading.classList.add('active');
    try {
      const res = await fetch(`/api/latency-checker?url=${encodeURIComponent(url)}`);
      const data = await res.json();
      loading.classList.remove('active');
      if (data.error) {
        error.textContent = data.error;
        error.classList.add('active');
        return;
      }

      const where = data.origin?.colo ? `el datacenter ${data.origin.colo} de Cloudflare` : 'un datacenter de Cloudflare';
      document.getElementById('origin-note')!.textContent = `Medimos 3 veces desde ${where}, el más cercano a vos. Es una medición real desde un solo lugar, no desde varios países.`;
      document.getElementById('fastest-value')!.textContent = `${data.min}ms`;
      document.getElementById('average-value')!.textContent = `${data.median}ms`;
      document.getElementById('slowest-value')!.textContent = `${data.max}ms`;

      const chartBody = document.getElementById('chart-body')!;
      chartBody.replaceChildren();
      const maxLatency = Math.max(...data.samples.map((s: any) => s.latency), 1);
      data.samples.forEach((s: any, i: number) => {
        const row = document.createElement('div');
        row.className = 'latency-row';
        const info = document.createElement('div');
        info.className = 'region-info';
        const name = document.createElement('div');
        name.className = 'region-name';
        name.textContent = `Medición ${i + 1}`;
        const code = document.createElement('div');
        code.className = 'region-code';
        code.textContent = `HTTP ${s.status}`;
        info.append(name, code);
        const barC = document.createElement('div');
        barC.className = 'bar-container';
        const bar = document.createElement('div');
        bar.className = `bar-fill ${speed(s.latency)}`;
        bar.style.width = `${(s.latency / maxLatency) * 100}%`;
        const val = document.createElement('span');
        val.className = 'bar-value';
        val.textContent = `${s.latency}ms`;
        bar.append(val);
        barC.append(bar);
        row.append(info, barC);
        chartBody.append(row);
      });

      const msg =
        data.median < 300 ? 'Tu sitio responde rápido.' :
        data.median < 1000 ? 'Tu sitio responde a un ritmo aceptable, pero se puede mejorar con caché o un CDN.' :
        'Tu sitio tarda en responder. Un CDN, caché o un mejor hosting pueden ayudar mucho.';
      const p = document.createElement('p');
      p.textContent = `${msg} El número incluye redirecciones, DNS y conexión segura (HTTPS).`;
      document.getElementById('insights-content')!.replaceChildren(p);

      container.style.display = 'block';
    } catch {
      loading.classList.remove('active');
      error.textContent = 'Error de conexión. Intentá de nuevo.';
      error.classList.add('active');
    }
  }

  btn.addEventListener('click', check);
  urlInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') check();
  });
</script>
