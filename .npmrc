# Supply-chain cooldown: only install versions published more than 14 days ago.
# Most malicious npm releases are detected and pulled within days.
# For an urgent security fix newer than that, override once:
#   npm install <pkg>@<version> --min-release-age=0
min-release-age=14
# Pin exact versions when adding dependencies (no ^ ranges).
save-exact=true
engine-strict=true
# Never run dependency install scripts (postinstall etc.), the usual vector of
# npm supply-chain attacks. The build works without them (esbuild and workerd
# ship their binaries as optional dependencies).
ignore-scripts=true
